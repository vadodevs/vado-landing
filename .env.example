VITE_SITE_URL=https://example.com
VITE_API_BASE_URL=http://localhost:8000
# El asistente del panel (Vado Intelligence) usa POST {VITE_API_BASE_URL|VITE_ADMIN_API_BASE_URL}/admin/assistant/chat con tu JWT.
VITE_ADMIN_API_BASE_URL=http://localhost:8000
VITE_ADMIN_EMAIL=
# Contraseña alfanumérica recomendada (evitar $ # etc. en .env). Alternativa: VITE_ADMIN_PASSWORD_B64 en base64.
VITE_ADMIN_PASSWORD=
